rules_version = '2';

// The security boundary (auth-and-roles §4). Anything not matched below is
// denied. Literals must match USER_ROLE, FIRESTORE_COLLECTION and the status
// constants in src/shared/domain. Nothing here covers a BLOCKED decision
// (docs/decisions/open-questions.md).
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    // Tenant ownership requires a recognized owner role, a server-issued tenant
    // claim and the matching owner record. Snake-case aliases keep Sprint_1
    // accounts compatible while the canonical fields remain camelCase.
    function isBusinessOwnerRecord(businessId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.get(
          'ownerUserId',
          get(/databases/$(database)/documents/businesses/$(businessId)).data.get('owner_id', null)
        ) == request.auth.uid;
    }

    function claimedBusinessId() {
      return request.auth.token.get(
        'businessId',
        request.auth.token.get('business_id', null)
      );
    }

    function ownsBusiness(businessId) {
      return (hasRole('subscriber') || hasRole('business_owner'))
        && claimedBusinessId() == businessId
        && isBusinessOwnerRecord(businessId);
    }

    // Collaborator of the business (Q1): the businessId and collaboratorId
    // claims must match, and the Collaborator record must be active, so a
    // deactivated collaborator (KAN-81) loses access at once.
    function collaboratorRecord(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)/collaborators/$(request.auth.token.collaboratorId)).data;
    }

    function isCollaboratorOf(businessId) {
      return hasRole('collaborator')
        && claimedBusinessId() == businessId
        && request.auth.token.collaboratorId is string
        && collaboratorRecord(businessId).status == 'active';
    }

    // Permission values match COLLABORATOR_PERMISSION (KAN-86).
    function collaboratorCan(businessId, permission) {
      return isCollaboratorOf(businessId)
        && collaboratorRecord(businessId).permissions.hasAny([permission]);
    }

    // pending, rejected, inactive and suspended businesses are read-only
    // (KAN-49, Q2).
    function businessIsWritable(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)).data.status == 'active';
    }

    function isBusinessPortalUser() {
      return (claimedBusinessId() is string
          && ownsBusiness(claimedBusinessId()))
        || (hasRole('collaborator')
          && claimedBusinessId() is string
          && isCollaboratorOf(claimedBusinessId()));
    }

    function isOptionalNullableString(data, field, maximumLength) {
      return !(field in data)
        || data[field] == null
        || (data[field] is string
          && data[field].size() > 0
          && data[field].size() <= maximumLength);
    }

    function isValidSocialLink(link) {
      return link is map
        && link.keys().hasOnly(['network', 'url'])
        && link.network in ['facebook', 'instagram', 'tiktok', 'website', 'whatsapp']
        && link.url is string
        && link.url.matches('^https://[^ ]+$');
    }

    function areValidSocialLinks(data) {
      return !('socialLinks' in data)
        || (data.socialLinks is list
          && data.socialLinks.size() <= 5
          && (data.socialLinks.size() < 1 || isValidSocialLink(data.socialLinks[0]))
          && (data.socialLinks.size() < 2 || isValidSocialLink(data.socialLinks[1]))
          && (data.socialLinks.size() < 3 || isValidSocialLink(data.socialLinks[2]))
          && (data.socialLinks.size() < 4 || isValidSocialLink(data.socialLinks[3]))
          && (data.socialLinks.size() < 5 || isValidSocialLink(data.socialLinks[4])));
    }

    function hasValidPublicProfile(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && isOptionalNullableString(data, 'description', 1000)
        && isOptionalNullableString(data, 'contactEmail', 320)
        && (!('contactEmail' in data)
          || data.contactEmail == null
          || data.contactEmail.matches('^[^@]+@[^@]+\\.[^@]+$'))
        && isOptionalNullableString(data, 'contactPhone', 25)
        && (!('contactPhone' in data)
          || data.contactPhone == null
          || data.contactPhone.matches('^\\+?[0-9 ()-]{7,25}$'))
        && isOptionalNullableString(data, 'logoUrl', 2048)
        && areValidSocialLinks(data);
    }

    match /businesses/{businessId} {
      allow read: if true; // public profile (KAN-112)
      allow create: if isSignedIn()
        && (
          request.resource.data.ownerUserId == request.auth.uid
          || request.resource.data.owner_id == request.auth.uid
        );
      allow update: if ownsBusiness(businessId)
        && businessIsWritable(businessId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'contactEmail',
          'contactPhone',
          'description',
          'logoUrl',
          'name',
          'socialLinks'
        ])
        && hasValidPublicProfile(request.resource.data);

      match /services/{serviceId} {
        allow read: if resource.data.status == 'active' || ownsBusiness(businessId) || isSuperAdmin()
          || isCollaboratorOf(businessId);
        allow create, update: if (ownsBusiness(businessId) || collaboratorCan(businessId, 'manage_services'))
          && businessIsWritable(businessId);
        allow delete: if false; // via the deleteService function (KAN-59)
      }

      match /bookings/{bookingId} {
        allow read: if ownsBusiness(businessId)
          || ((hasRole('customer') || hasRole('client')) && resource.data.customerUserId == request.auth.uid)
          || (isCollaboratorOf(businessId)
              && resource.data.collaboratorId == request.auth.token.collaboratorId)
          || collaboratorCan(businessId, 'manage_bookings');
        allow write: if false; // only via booking functions
      }

      match /customers/{customerId} {
        allow read, write: if ownsBusiness(businessId) && businessIsWritable(businessId);
        allow read: if collaboratorCan(businessId, 'manage_customers');
      }

      match /clients/{clientId} {
        allow read, write: if ownsBusiness(businessId) && businessIsWritable(businessId);
        allow read: if collaboratorCan(businessId, 'manage_customers');
      }

      // Collaborator records can be read by owner or self, and created by owner on sign-up
      match /collaborators/{collaboratorId} {
        allow read: if ownsBusiness(businessId)
          || (isCollaboratorOf(businessId) && collaboratorId == request.auth.token.collaboratorId);
        allow create, update: if isSignedIn()
          && (collaboratorId == request.auth.uid || ownsBusiness(businessId));
        allow delete: if false;
      }

      // Subscription can be read and initialized by the owner
      match /subscription/{subscriptionId} {
        allow read: if ownsBusiness(businessId);
        allow create, update: if false;
        allow delete: if false;
      }
    }

    match /businessSlugs/{slug} {
      allow read, write: if false;
    }

    // A deactivated plan keeps its subscribers (AC-KAN-176-06): the subscriber
    // can still read the plan of their own subscription (sidebar, KAN-40).
    // "current" is the subscription document id the sidebar reads
    // (BUSINESS_LAYOUT_CONSTANTS.CURRENT_DOCUMENT_ID) and the seed writes.
    function isSubscribedToPlan(planId) {
      return claimedBusinessId() is string
        && ownsBusiness(claimedBusinessId())
        && get(/databases/$(database)/documents/businesses/$(claimedBusinessId())/subscription/current).data.planId == planId;
    }

    // Public plan catalog and plan detail (KAN-7, KAN-21): anyone reads an
    // active plan; the super admin also reads inactive ones (KAN-184). Plans
    // are written only by functions, which write the audit entry (KAN-181).
    match /plans/{planId} {
      allow read: if resource.data.status == 'active'
        || isSuperAdmin()
        || isSubscribedToPlan(planId);
      allow write: if false;
    }

    // A customer lists their own bookings across businesses with a collection
    // group query on customerUserId (KAN-150). Read only; the per-business rule
    // above keeps covering every other role.
    match /{path=**}/bookings/{bookingId} {
      allow read: if (hasRole('customer') || hasRole('client'))
        && resource.data.customerUserId == request.auth.uid;
    }

    // Each user reads only their own profile. Business portal users may update
    // only their language and theme preferences (KAN-51, KAN-52), including
    // active collaborators.
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      allow create: if false;

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && isBusinessPortalUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['language', 'theme'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['language'])
          || request.resource.data.language in ['es', 'en'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['theme'])
          || request.resource.data.theme in ['light', 'dark', 'system']);
    }

    // Global parameters (KAN-182). Any signed-in user reads them (the idle
    // timeout, KAN-38); only the admin stories write them, so no client write.
    match /platformSettings/{platformSettingsId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /auditLog/{auditLogEntryId} {
      allow read: if isSuperAdmin();
      allow write: if false; // functions only
    }

    // Deny by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

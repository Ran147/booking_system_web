# Copy this file to .env.local (git-ignored) and fill in the values of the
# Firebase dev project: Firebase console > Project settings > Your apps > Web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# true: connect Auth, Firestore and Functions to the local Emulator Suite
# (npm run emulators). Empty Firebase values then fall back to the
# demo-booking-system project, which works offline.
VITE_USE_EMULATORS=true

# Firebase App Check with reCAPTCHA Enterprise (auth-and-roles §5).
# Not used while VITE_USE_EMULATORS=true.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# reCAPTCHA v2 checkbox on public forms such as sign-in (auth-and-roles §5).
# Empty with VITE_USE_EMULATORS=true: Google's public test key is used.
# The secret key never goes here: it is the RECAPTCHA_SECRET_KEY secret of
# Cloud Functions.
VITE_RECAPTCHA_SITE_KEY=
